name: Weekly hospital directory update

on:
  schedule:
    - cron: "0 5 * * 1"        # every Monday 05:00 UTC (08:00 Addis Ababa)
  workflow_dispatch:            # lets you press "Run workflow" to test it now

permissions:
  contents: write
  pull-requests: write
  issues: write

concurrency:
  group: weekly-hospital-update
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
    steps:
      - uses: actions/checkout@v4

      - name: Check the Gemini key secret exists
        run: |
          if [ -z "$GEMINI_API_KEY" ]; then
            echo "::error::Add GEMINI_API_KEY under Settings → Secrets and variables → Actions."
            exit 1
          fi

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - run: npm install --no-audit --no-fund

      - name: Search the web and verify candidates
        run: node scripts/discover.mjs

      - name: Open a pull request for your review
        uses: peter-evans/create-pull-request@v7
        with:
          branch: auto/weekly-directory-update
          delete-branch: true
          add-paths: public/data/hospitals-extra.json
          commit-message: "Weekly directory update (needs review)"
          title: "Weekly directory update — needs your confirmation"
          body-path: reports/pr-body.md
          labels: needs-review

      - name: Ask the developer for the weekly accuracy confirmation
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh label create needs-review --color FBCA04 --description "Auto-found directory changes awaiting confirmation" 2>/dev/null || true
          gh label create weekly-check --color 0E8A16 --description "Weekly accuracy confirmation" 2>/dev/null || true
          TITLE="Weekly accuracy confirmation — $(date -u +%F)"
          gh issue create --title "$TITLE" --body-file reports/issue.md --label weekly-check \
            --assignee "${{ github.repository_owner }}" \
          || gh issue create --title "$TITLE" --body-file reports/issue.md --label weekly-check

